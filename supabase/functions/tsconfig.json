{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "lib": ["esnext", "dom"],
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noImplicitAny": false
  },
  "include": [
    "./**/*.ts"
  ]
}
